// One Worker per environment: it serves the built frontend and passes /api/* and /b/*
// to the FastAPI container. Deployed only by .github/workflows/deploy.yml, after the Ship check.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/b/*"]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],
  "env": {
    // dev branch → staging (the Dev URL)
    "dev": {
      "name": "gamify-dev",
      "containers": [
        {
          "class_name": "Backend",
          "image": "./Dockerfile",
          "image_build_context": "../backend",
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "durable_objects": { "bindings": [{ "name": "BACKEND", "class_name": "Backend" }] },
      // The job runner: one call a minute to POST /api/jobs/run (keeps the container awake all day)
      "triggers": { "crons": ["* * * * *"] },
      // Days Neon's restore history keeps old data (not a secret): the photo deletion log's last date
      "vars": { "NEON_RESTORE_DAYS": "7" }
    },
    // main branch → production (the Live URL)
    "production": {
      "name": "gamify",
      "containers": [
        {
          "class_name": "Backend",
          "image": "./Dockerfile",
          "image_build_context": "../backend",
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "durable_objects": { "bindings": [{ "name": "BACKEND", "class_name": "Backend" }] },
      "triggers": { "crons": ["* * * * *"] },
      "vars": { "NEON_RESTORE_DAYS": "7" }
    }
  }
}
