# Copy to .env for local work. On Railway these live in the service's variables.
DATABASE_URL=postgresql+psycopg://localhost/gamify
# Where badge links point: this backend's public address (the QR on each badge opens <PUBLIC_BASE_URL>/b/<code>)
PUBLIC_BASE_URL=http://localhost:8000
# Where the guest app lives: /b/<code> sends the phone here, and only this origin may call the API
FRONTEND_URL=http://localhost:5173
# The Cloudflare Worker's shared secret for the every-minute job run (POST /api/jobs/run). Unset: job runs are refused
JOBS_SECRET=
# The staff secrets below are read once, when the app starts with an empty staff table; after that they are ignored
# One shared PIN for the registration desk, one password for the admin
DESK_PIN=
ADMIN_PASSWORD=
# One shared PIN for the partner stands in the market
STAND_PIN=
# Each moderator's name and own PIN: «name:PIN», separated by «;». Unset: nobody can open /moderate
MODERATORS=Модератор 1:;Модератор 2:;Модератор 3:

# Web push (VAPID). Leave empty: the app never asks for pushes and sends none
VAPID_PUBLIC_KEY=BL1uOj7ki1Ue78pYzoQEWFIuv7tbUl5715n6iNa1H6MMePXZCz5VzEP9dgAh8lVWDQWNpkhuGcCFYTbXvTRvNCc
VAPID_PRIVATE_KEY=w6D1yr3MmE_quCa3dE4aG-lp8BFI-ytbWgrQJQ-8gUk
VAPID_SUBJECT=manuchehr@ghafforzoda.net
# Days Neon's restore history keeps old data: the photo deletion log's last date. Not a secret; 7 when unset
NEON_RESTORE_DAYS=7